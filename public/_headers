# Cloudflare Pages response headers. Vite copies public/ into dist/.
#
# This is the deployed policy. deploy/stall-headers.conf is the same policy in
# nginx form, kept for the revisit condition in PLAN.md. src/csp.test.ts fails
# when the two disagree with the CSP constant in vite.config.ts.
#
# Not nginx: no quotes around values, no trailing semicolon, no "always".

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self'; font-src 'self'; object-src 'none'; frame-src 'none'; worker-src 'none'; connect-src 'self' https://chronik-native1.fabien.cash https://chronik-native2.fabien.cash https://chronik-native3.fabien.cash; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), display-capture=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=63072000
  Cache-Control: no-store

# Hashed filenames, so the bytes at a URL never change. Safe to cache hard
# only because the document above is never cached: a patched build has to be
# able to reach someone running the old one.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
