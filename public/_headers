# Cloudflare Pages response headers. Vite copies public/ into dist/.
#
# This is the deployed policy. deploy/stall-headers.conf is the same policy in
# nginx form, kept for the revisit condition in PLAN.md. src/csp.test.ts fails
# when the two disagree with the CSP constant in vite.config.ts.
#
# Not nginx: no quotes around values, no trailing semicolon, no "always".
#
# Pages MERGES every rule whose path matches, rather than letting the most
# specific one win. Cache-Control therefore cannot live on /*: that glob also
# matches /assets/*, and no-store merged into immutable wins, which is how the
# hashed-asset cache was silently dead. Measured on a live deployment.
# Rules match the REQUEST path, so /s/* still matches after the rewrite.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self'; font-src 'self'; object-src 'none'; frame-src 'none'; worker-src 'none'; connect-src 'self' https://chronik-native1.fabien.cash https://chronik-native2.fabien.cash https://chronik-native3.fabien.cash wss://chronik-native1.fabien.cash wss://chronik-native2.fabien.cash wss://chronik-native3.fabien.cash; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), display-capture=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=63072000

# The document, every path it is reachable at. Never cached: only the document
# points at the current hashes, so a cached one keeps someone on an old build
# that a fix cannot reach.
/
  Cache-Control: no-store

/s/*
  Cache-Control: no-store

/404.html
  Cache-Control: no-store

/404
  Cache-Control: no-store

# Unhashed and rewritten in place, so it must not ride the immutable rule
# below: a year-long cache would leave a new 404 page wearing old styling.
/404.css
  Cache-Control: no-store

# Hashed filenames, so the bytes at a URL never change. Safe to cache hard only
# because the document above is never cached.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
